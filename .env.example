# CyberShield Environment Configuration Example
# Copy this file to .env and adjust values for your deployment

# Application & Environment
APP_NAME="CyberShield: Safe Link Analyzer & Isolated Browser"
ENVIRONMENT=development
DATABASE_URL=sqlite:///./cybershield.db
# For PostgreSQL:
# DATABASE_URL=postgresql://cybershield:forensic_secure_pass@localhost:5432/cybershield_db

# Engine Signatures
ANALYZER_ENGINE_VERSION=CyberShield-ForensicEngine-v2.4.0
ANALYZER_SIGNATURE_ID=CS-RULESET-2026.10-R1

# Threat Intelligence (Optional live keys - leaves empty for offline/heuristic mode)
GOOGLE_SAFE_BROWSING_KEY=
VIRUSTOTAL_API_KEY=
ENABLE_LIVE_THREAT_FEEDS=false

# Network Boundary & SSRF Controls
BLOCK_PRIVATE_NETWORKS=true
BLOCK_CLOUD_METADATA=true
EGRESS_GATEWAY_URL=https://egress-gateway.cybershield.internal:8443

# Browser Isolation
ISOLATION_CONTAINER_ENABLED=true
SESSION_TIMEOUT_SECONDS=600
DISABLE_DOWNLOADS=true
DISABLE_CLIPBOARD=true
DISABLE_WEBRTC=true

# Privacy & Retention
DEFAULT_DATA_RETENTION_DAYS=30
AUTO_REDACT_SECRETS=true
